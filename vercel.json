{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?:www\\.)?hisaabsathi\\.com" }],
      "destination": "https://www.hisaabsathi.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "hisaabsathi.in" }],
      "destination": "https://www.hisaabsathi.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
